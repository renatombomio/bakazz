---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/layout/Navbar.astro";
import RenCollectionGallery from "../../components/archive/RenCollectionGallery.astro";
import { getRenCollectionItems } from "../../lib/ren-collection";
import { useT } from "../../i18n";

const lang = Astro.locals.lang;
const t = useT(lang);
const items = getRenCollectionItems(lang);
---
<Layout title={`${t("renCollection.pageTitle")} — BAKAZZ`}>
  <Navbar />
  <main id="main-content" class="ren-collection-page">
    <RenCollectionGallery items={items} lang={lang} />
  </main>
</Layout>

<style>
  .ren-collection-page {
    width: min(calc(100% - (var(--gutter) * 2)), var(--container-max));
    min-height: 70vh;
    margin-inline: auto;
    padding-block: clamp(6rem, 11vw, 10rem) var(--section-space);
  }
  @media (max-width: 700px) {
    .ren-collection-page { padding-top: 5rem; }
  }
</style>
