---
export const prerender = false;
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/layout/Navbar.astro";
import { createSupabaseSsrClient } from "../../lib/supabase-ssr";
import { localizedPath } from "../../i18n";
import UserRankBadge from "../../components/gamification/UserRankBadge.astro";
import { getNextAnimeRank, resolveAnimeRank } from "../../lib/gamification/ranks";

const lang = Astro.locals.lang;
const isEnglish = lang === "en";
const user = Astro.locals.renanimeUser;
if (!user) return Astro.redirect(localizedPath(Astro.locals.lang, "/login/"));
const supabase = createSupabaseSsrClient(Astro.request, Astro.cookies);
const { data: libraryData, error: libraryError } = await supabase
  .from("user_anime")
  .select("anime_id, status, updated_at")
  .eq("user_id", user.id)
  .order("updated_at", { ascending: false });

if (libraryError) {
  console.error("Renanime profile library error:", libraryError.message);
}

const { data: profileData } = await supabase
  .from("profiles")
  .select("id, name, aka, headline, bio, location, avatar_url, cover_url, interests, created_at, last_seen_at, instagram, tiktok")
  .eq("id", user.id)
  .maybeSingle();
const profile = { ...user, ...profileData };
const library = Array.isArray(libraryData) ? libraryData : [];
const watched = library.filter((entry: any) => entry?.status === "seen");
const pending = library.filter((entry: any) => entry?.status === "pending");
const seenAnimeCount = new Set(watched.map((entry: any) => entry?.anime_id).filter((id: any) => id !== null && id !== undefined)).size;
const currentRank = resolveAnimeRank(seenAnimeCount, isEnglish ? "en" : "es");
const nextRank = getNextAnimeRank(seenAnimeCount, isEnglish ? "en" : "es");
const rankProgressStart = currentRank?.minSeen ?? 0;
const rankProgressTarget = nextRank?.minSeen ?? currentRank?.minSeen ?? 0;
const rankProgress = nextRank && rankProgressTarget > rankProgressStart
  ? Math.min(100, Math.max(0, ((seenAnimeCount - rankProgressStart) / (rankProgressTarget - rankProgressStart)) * 100))
  : 100;
const { data: favoriteData, error: favoriteError } = await supabase
  .from("anime_likes")
  .select("anime_id, created_at", { count: "exact" })
  .eq("user_id", user.id)
  .order("created_at", { ascending: false })
  .limit(5);
if (favoriteError) console.error("Renanime profile favorites error:", favoriteError.message);
const favorites = Array.isArray(favoriteData) ? favoriteData : [];
const { data: characterFavoriteData, error: characterFavoriteError } = await supabase
  .from("character_likes")
  .select("character_id, created_at, characters(id, name, image_url, anime_characters(anime_id, role, sort_order))")
  .eq("user_id", user.id)
  .order("created_at", { ascending: false })
  .limit(4);
if (characterFavoriteError) console.error("Renanime profile character favorites error:", characterFavoriteError.message);
const characterFavorites = (characterFavoriteData ?? []).map((row: any) => ({
  ...(Array.isArray(row.characters) ? row.characters[0] : row.characters),
  character_id: row.character_id,
  anime_id: ((Array.isArray(row.characters) ? row.characters[0] : row.characters)?.anime_characters ?? [])
    .slice()
    .sort((a: any, b: any) => (a.role === "MAIN" ? 0 : 1) - (b.role === "MAIN" ? 0 : 1) || a.sort_order - b.sort_order)[0]?.anime_id ?? null,
})).filter((item: any) => item?.id && item?.name);
const favoriteCharacterIds = characterFavorites.map((item: any) => item.id).filter((id: any) => Number.isInteger(id));
let favoriteCharacterLikeTotals: Record<number, number> = {};
if (favoriteCharacterIds.length) {
  const { data: totals, error } = await supabase.from("character_like_totals").select("character_id, like_count").in("character_id", favoriteCharacterIds);
  if (error) console.error("Renanime favorite character like totals error:", error.message);
  else favoriteCharacterLikeTotals = Object.fromEntries((totals ?? []).map((row: any) => [row.character_id, Number(row.like_count ?? 0)]));
}
const characterAnimeIds = [...new Set(characterFavorites.map((item: any) => item.anime_id).filter((id: any) => Number.isInteger(id)))];
let characterAnimeTitles: Record<number, string> = {};
if (characterAnimeIds.length) {
  const variables: Record<string, number> = {};
  const fields = characterAnimeIds.map((id, index) => {
    variables["id" + index] = id;
    return "a" + index + ": Media(id: $id" + index + ", type: ANIME) { id title { romaji english } }";
  }).join("\n");
  const definitions = characterAnimeIds.map((_, index) => "$id" + index + ": Int!").join(", ");
  try {
    const response = await fetch("https://graphql.anilist.co", {
      method: "POST",
      headers: { "Content-Type": "application/json", "Accept": "application/json" },
      body: JSON.stringify({ query: "query CharacterAnimeTitles(" + definitions + ") { " + fields + " }", variables }),
    });
    if (response.ok) {
      const payload = await response.json();
      characterAnimeTitles = Object.fromEntries(characterAnimeIds.map((id, index) => {
        const anime = payload.data?.["a" + index];
        return [id, anime?.title?.english || anime?.title?.romaji || ""];
      }).filter((entry: any) => entry[1]));
    }
  } catch (error) {
    console.error("Renanime character anime titles error:", error);
  }
}
for (const character of characterFavorites) {
  character.anime_title = character.anime_id ? characterAnimeTitles[character.anime_id] ?? "" : "";
}
const { count: characterFavoritesCount } = await supabase
  .from("character_likes")
  .select("character_id", { count: "exact", head: true })
  .eq("user_id", user.id);
const favoritesCount = favoriteError ? 0 : (await supabase.from("anime_likes").select("anime_id", { count: "exact", head: true }).eq("user_id", user.id)).count ?? 0;
const { count: commentsCount, error: commentsCountError } = await supabase
  .from("anime_comments")
  .select("id", { count: "exact", head: true })
  .eq("user_id", user.id);
if (commentsCountError) console.error("Renanime profile comments count error:", commentsCountError.message);
const profileCommentsCount = commentsCountError ? 0 : commentsCount ?? 0;
const memberDate = profile.created_at ? new Date(profile.created_at).toLocaleDateString(isEnglish ? "en" : "es", { month: "short", year: "numeric" }) : "";
const { data: debateRows, error: debatesError } = await supabase.from("community_debates").select("id, title, created_at").eq("author_id", user.id).eq("status", "published").order("created_at", { ascending: false }).limit(6);
if (debatesError) console.error("Renanime profile debates error:", debatesError.message);
const debates = Array.isArray(debateRows) ? debateRows : [];
const debateIds = debates.map((debate: any) => debate.id);
let debateReplyCounts: Record<string, number> = {};
if (debateIds.length) {
  const { data: replies, error: repliesError } = await supabase.from("community_debate_comments").select("debate_id").in("debate_id", debateIds).eq("status", "published");
  if (repliesError) console.error("Renanime profile debate replies error:", repliesError.message);
  else debateReplyCounts = (replies ?? []).reduce((acc: Record<string, number>, row: any) => { acc[row.debate_id] = (acc[row.debate_id] ?? 0) + 1; return acc; }, {});
}
---

<Layout
  title={`${isEnglish ? "My Profile" : "Mi perfil"} — Renanime's Gallery`}
  description={isEnglish ? "Your personal profile on Renanime." : "Tu perfil personal en Renanime."}
>
  <Navbar />

  <main class="profile-page" data-anime-base={localizedPath(Astro.locals.lang, "/anime/")}>
    <section class="profile-card">
      <section class="profile-editor" aria-labelledby="profile-editor-title">
        <div class="cover-preview" id="cover-preview" style={profile.cover_url ? `background-image: linear-gradient(0deg, rgba(5,5,5,.94), rgba(5,5,5,.08)), url("${profile.cover_url}")` : undefined}>
          <button class="media-edit cover-edit" id="choose-cover-button" type="button" hidden>
            {isEnglish ? "Add cover photo" : "Añadir foto de portada"}
          </button>
          <input class="cover-file-input" id="cover-input" name="cover" type="file" accept="image/jpeg,image/png,image/webp,image/avif" aria-label={isEnglish ? "Choose cover photo" : "Elegir foto de portada"} />
          <span id="cover-upload-feedback" class="cover-upload-feedback" role="status" aria-live="polite"></span>
          <span class="presence-status cover-presence" id="profile-presence" aria-label={isEnglish ? "Online" : "En línea"} hidden><span class="presence-dot"></span><span>{isEnglish ? "Online" : "En línea"}</span></span>
        </div>
        <div class="identity-editor">
          <div class="avatar-wrap">
            <img id="avatar-preview" class="avatar-preview" src={profile.avatar_url || "/images/profile-avatar-placeholder.svg"} alt={isEnglish ? "Profile picture" : "Foto de perfil"} />
            <label class="avatar-edit" for="avatar-input" aria-label={isEnglish ? "Change profile picture" : "Cambiar foto de perfil"} title={isEnglish ? "Change profile picture" : "Cambiar foto de perfil"}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7.5h3l1.5-2h7l1.5 2h3v11H4z"/><circle cx="12" cy="13" r="3.2"/></svg>
            </label>
            <input class="file-input" id="avatar-input" type="file" accept="image/jpeg,image/png,image/webp,image/avif" />
          </div>
          <div class="identity-copy">
            <h2 id="identity-name">{profile.name}</h2>
            <p class="handle" id="identity-aka">@{profile.aka}</p>
            {currentRank && <div class="profile-rank-identity"><UserRankBadge rank={currentRank.key} size="compact" /><span>{currentRank.label}</span></div>}
          </div>
          <button class="profile-edit-toggle" id="toggle-profile-editor" type="button" aria-expanded="false" aria-controls="profile-editor-fields" aria-label={isEnglish ? "Edit profile information" : "Editar información del perfil"} title={isEnglish ? "Edit profile" : "Editar perfil"}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L8 18l-4 1 1-4Z"/></svg>
          </button>
        </div>
        <div class="editor-fields" id="profile-editor-fields" hidden>
          <h2 id="profile-editor-title">{isEnglish ? "Edit your information" : "Editar tu información"}</h2>
          <label>{isEnglish ? "Display name" : "Nombre"}
            <input id="profile-name" maxlength="40" value={profile.name || ""} placeholder={isEnglish ? "Your name" : "Tu nombre"} />
          </label>
          <label>{isEnglish ? "Username" : "Nombre de usuario"}
            <div class="username-input"><span>@</span><input id="profile-aka" maxlength="24" value={profile.aka || ""} placeholder="username" /></div>
          </label>
          <label>{isEnglish ? "Profile headline" : "Título"}
            <input id="profile-headline" maxlength="80" value={profile.headline || ""} placeholder={isEnglish ? "A line that says something about you…" : "Una frase que te represente…"} />
          </label>
          <label>{isEnglish ? "About me" : "Sobre mí"}
            <textarea id="profile-bio" maxlength="280" placeholder={isEnglish ? "Tell the community a little about yourself…" : "Cuéntale a la comunidad algo sobre ti…"}>{profile.bio || ""}</textarea>
          </label>
          <label>{isEnglish ? "Favourite anime genres" : "Géneros de anime favoritos"}
            <input id="profile-interests" maxlength="180" value={(profile.interests || []).join(", ")} placeholder={isEnglish ? "Action, fantasy, psychological…" : "Acción, fantasía, psicológico…"} />
            <span class="field-hint">{isEnglish ? "Separate genres with commas." : "Separa los géneros con comas."}</span>
          </label>
          <label>{isEnglish ? "Location (optional)" : "Ubicación (opcional)"}
            <input id="profile-location" maxlength="80" value={profile.location || ""} placeholder={isEnglish ? "City, country" : "Ciudad, país"} />
          </label>
          <div class="social-edit-fields">
            <label>Instagram
              <input id="profile-instagram" maxlength="120" value={profile.instagram || ""} placeholder="@usuario o instagram.com/usuario" autocomplete="off" autocapitalize="none" spellcheck="false" />
              <span class="social-field-error" id="instagram-error" hidden>{isEnglish ? "Invalid Instagram username or profile link." : "Usuario o enlace de Instagram no válido."}</span>
            </label>
            <label>TikTok
              <input id="profile-tiktok" maxlength="120" value={profile.tiktok || ""} placeholder="@usuario o tiktok.com/@usuario" autocomplete="off" autocapitalize="none" spellcheck="false" />
              <span class="social-field-error" id="tiktok-error" hidden>{isEnglish ? "Invalid TikTok username or profile link." : "Usuario o enlace de TikTok no válido."}</span>
            </label>
          </div>
          <label class="privacy-setting">
            <input id="profile-private" type="checkbox" checked={Boolean(profile.is_private)} />
            <span><strong>{isEnglish ? "Private profile" : "Perfil privado"}</strong><small>{isEnglish ? "Only you can see your anime collection and watchlist. Your profile will not appear in the community directory." : "Solo tú podrás ver tu colección y lista de anime. Tu perfil no aparecerá en el directorio de la comunidad."}</small></span>
          </label>
          <div class="editor-actions">
            <button class="save-profile" id="save-profile" type="button">{isEnglish ? "Save changes" : "Guardar cambios"}</button>
            <p id="profile-feedback" role="status" aria-live="polite"></p>
          </div>
          <p class="upload-note">{isEnglish ? "JPG, PNG, WebP or AVIF · Max. 5 MB per image." : "JPG, PNG, WebP o AVIF · Máximo 5 MB por imagen."}</p>
          <div class="account-danger-zone">
            <button class="delete-account-button" id="delete-account-button" type="button">{isEnglish ? "Delete account" : "Eliminar cuenta"}</button>
            <p>{isEnglish ? "Permanently delete your account and its associated data." : "Elimina permanentemente tu cuenta y los datos asociados."}</p>
          </div>
        </div>
      </section>

      <section class="profile-about" aria-label={isEnglish ? "About" : "Sobre mí"}>
        {profile.headline && <h1 id="profile-headline-view">{profile.headline}</h1>}
        {profile.bio && <p id="profile-bio-view">{profile.bio}</p>}
        <p class="profile-member-line">{profile.location ? profile.location + " · " : ""}{isEnglish ? "Member since" : "Miembro desde"} {memberDate}</p>
        {(profile.instagram || profile.tiktok) && <div class="profile-social-links">
          {profile.instagram && <a class="profile-social-button" href={`https://www.instagram.com/${profile.instagram}/`} target="_blank" rel="noopener noreferrer nofollow ugc" aria-label={`Instagram de ${profile.name}`}><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r="1.2" fill="currentColor" stroke="none"/></svg></a>}
          {profile.tiktok && <a class="profile-social-button" href={`https://www.tiktok.com/@${profile.tiktok}`} target="_blank" rel="noopener noreferrer nofollow ugc" aria-label={`TikTok de ${profile.name}`}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12.5 2v12.1a4 4 0 1 1-3.5-4"/></svg></a>}
        </div>}
        <div class="genre-tags" id="profile-genre-tags">{(profile.interests || []).map((genre: string) => <span>#{genre}</span>)}</div>
      </section>

      <section class="profile-stats" aria-label={isEnglish ? "Anime activity" : "Actividad anime"}>
        <a href={localizedPath(Astro.locals.lang, "/collection/")} class="profile-stat"><strong>{watched.length}</strong><span>{isEnglish ? "Viewed" : "Vistos"}</span></a>
        <a href={localizedPath(Astro.locals.lang, "/pending/")} class="profile-stat"><strong>{pending.length}</strong><span>{isEnglish ? "On my list" : "En mi lista"}</span></a>
        <a href="#profile-favorites-grid" class="profile-stat"><strong>{favoritesCount}</strong><span>{isEnglish ? "Favorites" : "Favoritos"}</span></a>
        <div class="profile-stat"><strong>{profileCommentsCount}</strong><span>{isEnglish ? "Comments" : "Comentarios"}</span></div>
      </section>

      <section class="profile-rank-progress" aria-label={isEnglish ? "Community rank progress" : "Progreso de rango de comunidad"}>
        <p class="profile-rank-summary">
          <strong>{currentRank?.label || (isEnglish ? "Unranked" : "Sin rango")}</strong>
          <span aria-hidden="true">·</span>
          {nextRank
            ? <span>{seenAnimeCount.toLocaleString(isEnglish ? "en" : "es")} {isEnglish ? "of" : "de"} {nextRank.minSeen.toLocaleString(isEnglish ? "en" : "es")} {isEnglish ? "for" : "para"} {nextRank.label}</span>
            : <span>{isEnglish ? "Maximum rank reached" : "Rango máximo alcanzado"}</span>}
        </p>
        <div class="profile-rank-track" role="progressbar" aria-label={isEnglish ? "Progress to next rank" : "Progreso hacia el siguiente rango"} aria-valuemin="0" aria-valuemax="100" aria-valuenow={Math.round(rankProgress)}>
          <span style={`width:${rankProgress}%`}></span>
        </div>
      </section>

      <section class="profile-library-links">
        <div class="profile-library-heading"><h2>{isEnglish ? "Favorite anime" : "Animes favoritos"}</h2><a href={localizedPath(Astro.locals.lang, "/profile/anime-favorites/")}>{isEnglish ? "See all" : "Ver todos"}</a></div>
        <div class="profile-favorites-wall" id="profile-favorites-grid" data-ids={JSON.stringify(favorites.map((entry: any) => String(entry.anime_id)))}></div>

        <div class="profile-library-heading" id="profile-character-favorites"><h2>{isEnglish ? "Favourite characters" : "Personajes favoritos"}</h2><a href={localizedPath(Astro.locals.lang, "/profile/characters/")}>{isEnglish ? "See all" : "Ver todos"}</a></div>
        {characterFavorites.length ? <div class="profile-character-row">
          {characterFavorites.map((character: any) => <a class="profile-character-card" href={character.anime_id ? localizedPath(Astro.locals.lang, "/anime/" + character.anime_id + "/") : "#profile-character-favorites"} data-character-id={character.id} data-like-count={favoriteCharacterLikeTotals[character.id] ?? 0}>
            {character.image_url && <img src={character.image_url} alt="" loading="lazy" />}
            <strong>{character.name}</strong><span>{character.anime_title || (isEnglish ? "Anime unavailable" : "Anime no disponible")}</span><small class="profile-character-likes">♥ {(favoriteCharacterLikeTotals[character.id] ?? 0).toLocaleString(isEnglish ? "en" : "es", { notation: "compact", maximumFractionDigits: 1 })}</small>
          </a>)}
        </div> : <p class="profile-character-empty">{isEnglish ? "You haven't liked any characters yet." : "Todavía no has marcado personajes como favoritos."}</p>}

        <div class="profile-library-heading profile-library-tabs-heading"><h2>{isEnglish ? "My library" : "Mi biblioteca"}</h2></div>
        <div class="profile-tabs" role="tablist" aria-label={isEnglish ? "My anime lists" : "Mis listas de anime"}>
          <button type="button" role="tab" id="tab-watched" aria-selected="true" aria-controls="panel-watched">{isEnglish ? "Collection" : "Colección"}</button>
          <button type="button" role="tab" id="tab-pending" aria-selected="false" aria-controls="panel-pending">{isEnglish ? "My list" : "Mi lista"}</button>
        </div>
        <div id="panel-watched" role="tabpanel" aria-labelledby="tab-watched">
          <div class="profile-anime-grid" id="profile-watched-grid" data-ids={JSON.stringify(watched.slice(0, 12).map((entry: any) => String(entry.anime_id)))}></div>
          <a class="profile-see-all" href={localizedPath(Astro.locals.lang, "/collection/")}>{isEnglish ? "View collection" : "Ver colección"}</a>
        </div>
        <div id="panel-pending" role="tabpanel" aria-labelledby="tab-pending" hidden>
          <div class="profile-anime-grid" id="profile-pending-grid" data-ids={JSON.stringify(pending.slice(0, 12).map((entry: any) => String(entry.anime_id)))}></div>
          <a class="profile-see-all" href={localizedPath(Astro.locals.lang, "/pending/")}>{isEnglish ? "View list" : "Ver lista"}</a>
        </div>
      </section>

      <section class="profile-debates">
        <div class="profile-library-heading"><h2>{isEnglish ? "My debates" : "Mis debates"}</h2><a href={localizedPath(Astro.locals.lang, "/community/debates/")}>{isEnglish ? "Community" : "Comunidad"}</a></div>
        {debates.length ? <div class="profile-debate-list">{debates.map((debate: any) => <a class="profile-debate" href={localizedPath(Astro.locals.lang, "/community/debates/" + debate.id + "/")}>
          <strong>{debate.title}</strong><span>{(debateReplyCounts[debate.id] ?? 0).toLocaleString(isEnglish ? "en" : "es")} {isEnglish ? "replies" : "respuestas"} · {new Date(debate.created_at).toLocaleDateString(isEnglish ? "en" : "es", { day: "numeric", month: "short", year: "numeric" })}</span>
        </a>)}</div> : <p class="profile-debate-empty">{isEnglish ? "You haven't started any debates yet." : "Todavía no has iniciado ningún debate."}</p>}
      </section>

      <section class="image-cropper" id="image-cropper" hidden aria-modal="true" role="dialog" aria-labelledby="cropper-title">
        <div class="cropper-panel">
          <header class="cropper-header"><h2 id="cropper-title"></h2><p id="cropper-help"></p></header>
          <div class="cropper-stage" id="cropper-stage"><canvas id="cropper-canvas"></canvas></div>
          <div class="cropper-actions">
            <button type="button" class="cropper-cancel" id="cropper-cancel">{isEnglish ? "Cancel" : "Cancelar"}</button>
            <button type="button" class="cropper-apply" id="cropper-apply">{isEnglish ? "Apply" : "Aplicar"}</button>
          </div>
        </div>
      </section>
    </section>
  </main>
</Layout>

<style>
  .profile-character-see-all{display:inline-flex;margin:0 0 20px;color:#ec4899;font-size:.78rem;text-decoration:none}
  .profile main .profile-character-grid,.profile-character-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:12px;margin:12px 0 24px}
  .profile-character-card{display:grid;grid-template-rows:auto 1fr;gap:9px;min-width:0;padding:8px;border:1px solid rgba(255,255,255,.12);border-radius:13px;background:#101012}
  .profile-character-card>img{display:block;width:100%;aspect-ratio:1/1.12;object-fit:cover;object-position:center 25%;border-radius:9px;background:#222}
  .profile-character-copy{display:grid;gap:4px;min-width:0;padding:0 2px 2px}
  .profile-character-copy strong{font-size:.78rem;line-height:1.25;overflow-wrap:anywhere}
  .profile-character-copy span{color:#99939f;font-size:.68rem}
  .profile-character-empty{margin:8px 0 24px;color:#aaa4b0;font-size:.8rem;line-height:1.5}
  @media(max-width:600px){.profile main .profile-character-grid,.profile-character-grid{grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:8px}.profile-character-card{gap:7px;padding:6px}.profile-character-copy strong{font-size:.7rem}}
  .image-cropper[hidden]{display:none!important}
  .image-cropper{position:fixed;inset:0;z-index:1000;display:grid;place-items:center;padding:20px;background:rgba(0,0,0,.88);backdrop-filter:blur(12px)}
  .cropper-panel{width:min(100%,560px);display:grid;gap:18px;padding:20px;border-radius:20px;background:#111114;box-shadow:0 24px 80px rgba(0,0,0,.5)}
  .cropper-header h2{margin:0;font-size:1.1rem}.cropper-header p{margin:6px 0 0;color:#999;font-size:.78rem;line-height:1.45}
  .cropper-stage{display:grid;place-items:center;max-height:62vh;overflow:hidden;border-radius:12px;background:#050505}
  #cropper-canvas{display:block;max-width:100%;max-height:62vh;object-fit:contain;touch-action:none;cursor:grab}
  #cropper-canvas:active{cursor:grabbing}
  .cropper-actions{display:flex;align-items:center;justify-content:space-between;gap:12px}
  .cropper-actions button{min-width:112px;padding:12px 20px;border:0;border-radius:999px;font:inherit;font-size:.85rem;font-weight:650;cursor:pointer}
  .cropper-cancel{background:transparent!important;color:#ddd;border:1px solid rgba(255,255,255,.14)!important}
  .cropper-apply{background:#ec4899;color:#fff}
