    if (!(target instanceof Element)) return;

    const toggle = target.closest<HTMLButtonElement>("#toggle-profile-editor");
    if (toggle) {
      const editor = document.querySelector<HTMLElement>(".profile-editor");
      const fields = document.querySelector<HTMLElement>("#profile-editor-fields");
      const coverButton = document.querySelector<HTMLButtonElement>("#choose-cover-button");
      if (!fields) return;
      const opening = fields.hidden;
      fields.hidden = !opening;
      if (coverButton) coverButton.hidden = !opening;
      editor?.classList.toggle("is-editing", opening);
      toggle.setAttribute("aria-expanded", String(opening));
      if (opening) fields.querySelector<HTMLInputElement>("input")?.focus();
      return;
    }

    const deleteButton = target.closest<HTMLButtonElement>("#delete-account-button");
    if (deleteButton) {
      const confirmation = window.prompt(copy("Esta acción es irreversible. Escribe ELIMINAR para borrar tu cuenta y los datos asociados.", "This action is permanent. Type DELETE to remove your account and associated data."));
      if (confirmation !== (isEnglish ? "DELETE" : "ELIMINAR")) return;
      deleteButton.disabled = true;
      deleteButton.textContent = copy("Eliminando cuenta…", "Deleting account…");
      try {
        const response = await fetch("/api/auth/account/delete", { method: "POST", credentials: "same-origin", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ confirmation }) });
        const result = await response.json().catch(() => ({}));
        if (!response.ok || !result.ok) throw new Error(result.error || "DELETE_FAILED");
        window.location.assign(isEnglish ? "/en/" : "/");
      } catch (error) {
        deleteButton.disabled = false;
        deleteButton.textContent = copy("Eliminar cuenta", "Delete account");
        window.alert(copy("No se pudo eliminar la cuenta. No se han confirmado cambios.", "The account could not be deleted. No changes were confirmed."));
        console.error("Account deletion failed:", error);
      }
      return;
    }

    const coverButton = target.closest<HTMLButtonElement>("#choose-cover-button");
    if (coverButton) {
      const input = document.querySelector<HTMLInputElement>("#cover-input");
      input?.click();
    }
  });
  const feedback = document.querySelector<HTMLElement>("#profile-feedback");
  const copy = (es: string, en: string) => isEnglish ? en : es;

  async function loadProfileAnime() {
    const grids = ["#profile-watched-grid", "#profile-pending-grid", "#profile-favorites-grid"]
      .map(selector => document.querySelector<HTMLElement>(selector)).filter(Boolean) as HTMLElement[];
    const ids = [...new Set(grids.flatMap(grid => JSON.parse(grid.dataset.ids || "[]") as string[]))].filter(id => /^\d+$/.test(id));
    if (!ids.length) {
      grids.forEach(grid => { grid.innerHTML = '<span class="profile-anime-empty">' + copy("Todavía no hay animes aquí.", "No anime here yet.") + '</span>'; });
      return;
    }
    const variables: Record<string, number> = {};
    const fields = ids.map((id, index) => { variables["id" + index] = Number(id); return `a${index}: Media(id: $id${index}, type: ANIME) { id title { romaji english } coverImage { large } }`; }).join("\n");
    const definitions = ids.map((_, index) => `$id${index}: Int!`).join(", ");
    try {
      const [animeResponse, likeResponse] = await Promise.all([
        fetch("https://graphql.anilist.co", { method:"POST", headers:{"Content-Type":"application/json","Accept":"application/json"}, body:JSON.stringify({query:`query ProfileAnime(${definitions}) { ${fields} }`,variables}) }),
        fetch("/api/anime/likes?ids="+ids.join(","), {credentials:"same-origin",cache:"no-store"})
      ]);
      if (!animeResponse.ok) throw new Error("anime_fetch_failed");
      const payload = await animeResponse.json();
      const likePayload = likeResponse.ok ? await likeResponse.json() : { likes:{} };
      const media = new Map(ids.map((id,index) => [id,payload.data?.["a"+index]]));
      grids.forEach(grid => {
        const gridIds = JSON.parse(grid.dataset.ids || "[]") as string[];
        const cards: HTMLElement[] = gridIds.map(id => {
          const anime = media.get(id);
          if (!anime) return null;
          const title = anime.title?.english || anime.title?.romaji || "Anime";
          const counts = likePayload.likes?.[id] || {count:0,liked:false};
          const card = document.createElement("a"); card.className = "profile-anime-card"; card.href = (document.querySelector<HTMLElement>(".profile-page")?.dataset.animeBase || "/anime/") + id + "/"; card.setAttribute("aria-label",title);
          const img = document.createElement("img"); img.src = anime.coverImage?.large || ""; img.alt = ""; img.loading = "lazy";
          const cardCopy = document.createElement("span"); cardCopy.className = "profile-anime-card-copy";
          const titleNode = document.createElement("span"); titleNode.className = "profile-anime-card-title"; titleNode.textContent = title;
          const meta = document.createElement("span"); meta.className = "profile-anime-card-meta";
          const likeMeta = document.createElement("span"); likeMeta.className = "like-count" + (counts.liked ? " is-liked" : ""); likeMeta.innerHTML = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.8 8.8c0 5.2-8.8 10-8.8 10s-8.8-4.8-8.8-10a4.6 4.6 0 0 1 8.8-1.9 4.6 4.6 0 0 1 8.8 1.9Z"/></svg><span></span>'; likeMeta.querySelector("span")!.textContent = Number(counts.count||0).toLocaleString(isEnglish?"en":"es");
          meta.append(likeMeta); cardCopy.append(titleNode); card.append(img,cardCopy,meta);
          if (grid.id === "profile-favorites-grid") {
            const pill = document.createElement("span"); pill.className = "profile-favorite-like" + (counts.liked ? " is-liked" : "");
            pill.innerHTML = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"/></svg><span></span>';
            pill.querySelector("span")!.textContent = new Intl.NumberFormat(isEnglish ? "en" : "es", {notation:"compact",maximumFractionDigits:1}).format(Number(counts.count ?? 0));
            card.append(pill);
          }
          return card;
        }).filter((card): card is HTMLAnchorElement => card instanceof HTMLAnchorElement);
        grid.replaceChildren(...(cards.length ? cards : [Object.assign(document.createElement("span"),{className:"profile-anime-empty",textContent:copy("Todavía no hay animes aquí.","No anime here yet.")})]));
      });
    } catch {
      grids.forEach(grid => { grid.innerHTML = '<span class="profile-anime-empty">' + copy("No se pudieron cargar los animes.", "Could not load anime.") + '</span>'; });
    }
  }
  void loadProfileAnime();

  async function uploadImage(kind: "avatar" | "cover", file: File) {
    if (file.size > 5 * 1024 * 1024) throw new Error(copy("La imagen supera el límite de 5 MB.", "Image exceeds the 5 MB limit."));
    const form = new FormData();
    form.set("kind", kind);
    form.set("file", file);
    const response = await fetch("/api/auth/profile/media", { method: "POST", body: form, credentials: "same-origin" });
    const result = await response.json().catch(() => ({}));
    if (!response.ok || !result.ok) {
      const reason = typeof result.error === "string" ? result.error : "UPLOAD_FAILED";
      throw new Error(copy("No se pudo subir la imagen (" + reason + ").", "Image upload failed (" + reason + ")."));
    }
    return result.url as string;
  }

  // Delegate media controls: Astro ClientRouter swaps page DOM without rerunning this module.


  let cropState: { kind: "avatar" | "cover"; image: HTMLImageElement; zoom: number; baseScale: number; x: number; y: number } | null = null;
  const cropModal = document.querySelector<HTMLElement>("#image-cropper");
  const cropCanvas = document.querySelector<HTMLCanvasElement>("#cropper-canvas");
  const cropContext = cropCanvas?.getContext("2d");
  const activePointers = new Map<number, {x:number;y:number}>();
  let pinchStart: {distance:number;zoom:number} | null = null;

  function drawCrop() {
    if (!cropState || !cropCanvas || !cropContext) return;
    const state = cropState;
    const scale = state.baseScale * state.zoom;
    const drawWidth = state.image.naturalWidth * scale;
    const drawHeight = state.image.naturalHeight * scale;
    state.x = Math.min(0, Math.max(cropCanvas.width-drawWidth, state.x));
    state.y = Math.min(0, Math.max(cropCanvas.height-drawHeight, state.y));
    cropContext.clearRect(0,0,cropCanvas.width,cropCanvas.height);
    cropContext.fillStyle = "#080808";
    cropContext.fillRect(0,0,cropCanvas.width,cropCanvas.height);
    cropContext.drawImage(state.image,state.x,state.y,drawWidth,drawHeight);
  }

  function openCropper(kind: "avatar" | "cover", file: File) {
    if(!cropModal || !cropCanvas || !cropContext) throw new Error("Image editor unavailable");
    const image = new Image();
    const objectUrl = URL.createObjectURL(file);
    image.onload = () => {
      const preview = document.querySelector<HTMLElement>("#cover-preview");
      const ratio = kind === "avatar" ? 1 : Math.max(1.5,Math.min(3.5,(preview?.clientWidth||900)/(preview?.clientHeight||260)));
      const outputWidth = kind === "avatar" ? 720 : 1440;
      cropCanvas.width = outputWidth;
      cropCanvas.height = Math.round(outputWidth/ratio);
      const baseScale = Math.max(cropCanvas.width/image.naturalWidth,cropCanvas.height/image.naturalHeight);
      const drawWidth = image.naturalWidth*baseScale;
      const drawHeight = image.naturalHeight*baseScale;
      cropState = {kind,image,zoom:1,baseScale,x:(cropCanvas.width-drawWidth)/2,y:(cropCanvas.height-drawHeight)/2};
      const title = document.querySelector<HTMLElement>("#cropper-title");
      const help = document.querySelector<HTMLElement>("#cropper-help");
      if(title) title.textContent = kind === "avatar" ? copy("Ajustar foto de perfil","Adjust profile picture") : copy("Ajustar foto de portada","Adjust cover photo");
      if(help) help.textContent = kind === "avatar" ? copy("Pellizca para acercar o alejar. Arrastra para encuadrar.","Pinch to zoom. Drag to position.") : copy("Desliza la imagen con un dedo para elegir el encuadre.","Drag the image with one finger to position it.");
      cropModal.hidden = false;
      document.body.style.overflow = "hidden";
      activePointers.clear();
      drawCrop();
      URL.revokeObjectURL(objectUrl);
      document.querySelector<HTMLButtonElement>("#cropper-cancel")?.focus();
    };
    image.onerror = () => {
      URL.revokeObjectURL(objectUrl);
      const status = document.querySelector<HTMLElement>("#profile-feedback") || document.querySelector<HTMLElement>("#cover-upload-feedback");
      if(status) status.textContent = copy("No se pudo abrir la imagen.","Could not open this image.");
    };
    image.src = objectUrl;
  }

  function closeCropper() {
    if(cropModal) cropModal.hidden = true;
    document.body.style.overflow = "";
    cropState = null;
    activePointers.clear();
    pinchStart = null;
  }
  function pointerDistance() {
    const points=[...activePointers.values()];
    return points.length<2?0:Math.hypot(points[0].x-points[1].x,points[0].y-points[1].y);
  }
  cropCanvas?.addEventListener("pointerdown",event=>{
    if(!cropState)return;
    cropCanvas.setPointerCapture(event.pointerId);
    activePointers.set(event.pointerId,{x:event.clientX,y:event.clientY});
    if(activePointers.size===2)pinchStart={distance:pointerDistance(),zoom:cropState.zoom};
  });
  cropCanvas?.addEventListener("pointermove",event=>{
    if(!cropState||!activePointers.has(event.pointerId))return;
    const previous=activePointers.get(event.pointerId)!;
    activePointers.set(event.pointerId,{x:event.clientX,y:event.clientY});
    if(activePointers.size>=2&&cropState.kind==="avatar"){
      const distance=pointerDistance();
      if(pinchStart&&pinchStart.distance>0){
        cropState.zoom=Math.max(1,Math.min(4,pinchStart.zoom*distance/pinchStart.distance));
        drawCrop();
      }
    }else if(activePointers.size===1){
      const rect=cropCanvas.getBoundingClientRect();
      cropState.x+=(event.clientX-previous.x)*(cropCanvas.width/rect.width);
      cropState.y+=(event.clientY-previous.y)*(cropCanvas.height/rect.height);
      drawCrop();
    }
  });
  const endCropPointer=(event:PointerEvent)=>{
    activePointers.delete(event.pointerId);
    pinchStart=null;
  };
  cropCanvas?.addEventListener("pointerup",endCropPointer);
  cropCanvas?.addEventListener("pointercancel",endCropPointer);
  cropCanvas?.addEventListener("wheel",event=>{
    if(!cropState||cropState.kind!=="avatar")return;
    event.preventDefault();
    cropState.zoom=Math.max(1,Math.min(4,cropState.zoom*(event.deltaY<0?1.08:.92)));
    drawCrop();
  },{passive:false});

  document.querySelector<HTMLButtonElement>("#cropper-cancel")?.addEventListener("click",closeCropper);
  cropModal?.addEventListener("click",event=>{if(event.target===cropModal)closeCropper();});
  document.addEventListener("keydown",event=>{if(event.key==="Escape"&&cropModal&&!cropModal.hidden)closeCropper();});

  document.querySelector<HTMLButtonElement>("#cropper-apply")?.addEventListener("click",async event=>{
    if(!cropState||!cropCanvas)return;
    const button=event.currentTarget as HTMLButtonElement;
    const state=cropState;
    button.disabled=true;
    const status=document.querySelector<HTMLElement>("#profile-feedback")||document.querySelector<HTMLElement>("#cover-upload-feedback");
    if(status)status.textContent=state.kind==="avatar"?copy("Guardando foto…","Saving picture…"):copy("Guardando portada…","Saving cover…");
    try{
      const blob=await new Promise<Blob>((resolve,reject)=>cropCanvas.toBlob(value=>value?resolve(value):reject(new Error("CROP_EXPORT_FAILED")),"image/jpeg",.9));
      const file=new File([blob],state.kind==="avatar"?"profile-avatar.jpg":"profile-cover.jpg",{type:"image/jpeg",lastModified:Date.now()});
      const url=await uploadImage(state.kind,file);
      if(state.kind==="avatar"){
        const preview=document.querySelector<HTMLImageElement>("#avatar-preview");
        if(preview)preview.src=url;
      }else{
        const preview=document.querySelector<HTMLElement>("#cover-preview");
        if(preview){
          preview.style.backgroundImage=`linear-gradient(0deg, rgba(5,5,5,.94), rgba(5,5,5,.08)), url("${url}")`;
          preview.style.backgroundPosition="center";
          preview.dataset.coverUrl=url;
        }
      }
      closeCropper();
      if(status)status.textContent=state.kind==="avatar"?copy("Foto de perfil actualizada.","Profile picture updated."):copy("Banner actualizado.","Cover updated.");
    }catch(error){
      if(status)status.textContent=error instanceof Error?error.message:copy("No se pudo guardar la imagen.","Could not save image.");
    }finally{button.disabled=false;}
  });

  document.addEventListener("change",event=>{
    const input=event.target;
    if(!(input instanceof HTMLInputElement)||(input.id!=="avatar-input"&&input.id!=="cover-input"))return;
    const file=input.files?.[0];
    if(!file)return;
    const kind=input.id==="avatar-input"?"avatar":"cover";
    if(file.size>5*1024*1024){
      const status=document.querySelector<HTMLElement>("#profile-feedback")||document.querySelector<HTMLElement>("#cover-upload-feedback");
      if(status)status.textContent=copy("La imagen supera el límite de 5 MB.","Image exceeds the 5 MB limit.");
      input.value="";
      return;
    }
    openCropper(kind,file);
    input.value="";
  });


  const normalizeSocial = (kind: "instagram" | "tiktok", input: string): {ok:true;value:string|null}|{ok:false} => {
    const rules = {
      instagram: { re: /^[a-z0-9._]{1,30}$/, hosts: ["instagram.com","instagr.am"] },
      tiktok: { re: /^[a-z0-9._]{2,24}$/, hosts: ["tiktok.com"] }
    };
    const reserved = new Set(["p","reel","reels","explore","stories","tv","accounts","direct","video","tag","discover"]);
    let value = input.trim();
    if (!value) return {ok:true,value:null};
    if (/[/.]/.test(value) && /^(https?:\/\/)?[^\\s/]+\.[^\\s/]+\//i.test(value + "/")) {
      try {
        const url = new URL(/^https?:\/\//i.test(value) ? value : "https://" + value);
        const host = url.hostname.replace(/^(www|m)\./,"").toLowerCase();
        if (!rules[kind].hosts.includes(host)) return {ok:false};
        value = url.pathname.split("/").filter(Boolean)[0] || "";
        if (reserved.has(value.toLowerCase()) || (kind === "tiktok" && !value.startsWith("@"))) return {ok:false};
      } catch { return {ok:false}; }
    }
    value = value.replace(/^@+/,"").toLowerCase();
    if (!rules[kind].re.test(value) || value.endsWith(".")) return {ok:false};
    return {ok:true,value};
  };
  const socialInputs = {
    instagram: document.querySelector<HTMLInputElement>("#profile-instagram"),
    tiktok: document.querySelector<HTMLInputElement>("#profile-tiktok")
  };
  const saveButton = document.querySelector<HTMLButtonElement>("#save-profile");
  function validateSocialFields() {
    let valid = true;
    for (const kind of ["instagram","tiktok"] as const) {
      const input = socialInputs[kind];
      const result = normalizeSocial(kind,input?.value || "");
      const error = document.querySelector<HTMLElement>(kind === "instagram" ? "#instagram-error" : "#tiktok-error");
      if (error) error.hidden = result.ok;
      input?.setAttribute("aria-invalid",String(!result.ok));
      if (!result.ok) valid = false;
    }
    if (saveButton) saveButton.disabled = !valid;
    return valid;
  }
  for (const kind of ["instagram","tiktok"] as const) {
    const input = socialInputs[kind];
    input?.addEventListener("input",validateSocialFields);
    input?.addEventListener("blur",() => {
      const result = normalizeSocial(kind,input.value);
      if (result.ok) input.value = result.value || "";
      validateSocialFields();
    });
  }
  validateSocialFields();

  saveButton?.addEventListener("click", async (event) => {
    const button = event.currentTarget as HTMLButtonElement;
    if (!validateSocialFields()) return;
    button.disabled = true;
    if (feedback) feedback.textContent = copy("Guardando…", "Saving…");
    try {
      const socialInstagram = normalizeSocial("instagram",socialInputs.instagram?.value || "");
      const socialTiktok = normalizeSocial("tiktok",socialInputs.tiktok?.value || "");
      if (!socialInstagram.ok || !socialTiktok.ok) throw new Error(copy("Revisa los usuarios de redes sociales.","Check the social usernames."));
      const response = await fetch("/api/auth/profile", {
        method: "POST", headers: { "Content-Type": "application/json" }, credentials: "same-origin",
        body: JSON.stringify({
          name: (document.querySelector<HTMLInputElement>("#profile-name")?.value || "").trim(),
          aka: (document.querySelector<HTMLInputElement>("#profile-aka")?.value || "").trim(),
          bio: (document.querySelector<HTMLTextAreaElement>("#profile-bio")?.value || "").trim(),
          location: (document.querySelector<HTMLInputElement>("#profile-location")?.value || "").trim(),
          headline: (document.querySelector<HTMLInputElement>("#profile-headline")?.value || "").trim(),
          interests: (document.querySelector<HTMLInputElement>("#profile-interests")?.value || "").split(",").map(value => value.trim()).filter(Boolean),
          instagram: socialInstagram.value, tiktok: socialTiktok.value,
          isPrivate: Boolean(document.querySelector<HTMLInputElement>("#profile-private")?.checked)
        })
      });
      const result = await response.json();
      if (!response.ok || !result.ok) throw new Error(result.error || copy("No se pudieron guardar los cambios.", "Could not save changes."));
      const profile = result.profile || {};
      const name = profile.name || (document.querySelector<HTMLInputElement>("#profile-name")?.value || "").trim();
      const aka = profile.aka || (document.querySelector<HTMLInputElement>("#profile-aka")?.value || "").trim();
      const nameNode = document.querySelector<HTMLElement>("#identity-name");
      const akaNode = document.querySelector<HTMLElement>("#identity-aka");
      if (nameNode) nameNode.textContent = name;
      if (akaNode) akaNode.textContent = "@" + aka;
      for (const [selector,value,tag,id] of [
        ["#profile-headline-view",(document.querySelector<HTMLInputElement>("#profile-headline")?.value || "").trim(),"h1","profile-headline-view"],
        ["#profile-bio-view",(document.querySelector<HTMLTextAreaElement>("#profile-bio")?.value || "").trim(),"p","profile-bio-view"]
      ] as const) {
        let node = document.querySelector<HTMLElement>(selector);
        if (!value) node?.remove();
        else if (node) node.textContent = value;
        else { node = document.createElement(tag); node.id = id; node.textContent = value; document.querySelector(".profile-about")?.prepend(node); }
      }
      const interests = (document.querySelector<HTMLInputElement>("#profile-interests")?.value || "").split(",").map(v=>v.trim()).filter(Boolean);
      const tags = document.querySelector<HTMLElement>("#profile-genre-tags");
      if (tags) tags.replaceChildren(...interests.map(genre=>{const span=document.createElement("span");span.textContent="#"+genre;return span;}));
      let links = document.querySelector<HTMLElement>(".profile-social-links");
      if (socialInstagram.value || socialTiktok.value) {
        if (!links) { links=document.createElement("div"); links.className="profile-social-links"; document.querySelector(".profile-about")?.append(links); }
        links.replaceChildren();
        for (const [kind,handle] of [["instagram",socialInstagram.value],["tiktok",socialTiktok.value]] as const) {
          if (!handle) continue;
          const link=document.createElement("a"); link.className="profile-social-button"; link.target="_blank"; link.rel="noopener noreferrer nofollow ugc";
          link.href=kind==="instagram" ? "https://www.instagram.com/"+handle+"/" : "https://www.tiktok.com/@"+handle;
          link.setAttribute("aria-label",(kind==="instagram"?"Instagram":"TikTok")+" de "+name);
          link.textContent=kind==="instagram"?"IG":"♪"; links.append(link);
        }
      } else links?.remove();
      const fields = document.querySelector<HTMLElement>("#profile-editor-fields");
      const editor = document.querySelector<HTMLElement>(".profile-editor");
      const toggle = document.querySelector<HTMLButtonElement>("#toggle-profile-editor");
      const coverButton = document.querySelector<HTMLButtonElement>("#choose-cover-button");
      if (fields) fields.hidden = true;
      if (coverButton) coverButton.hidden = true;
      editor?.classList.remove("is-editing");
      toggle?.setAttribute("aria-expanded","false");
      if (feedback) feedback.textContent = "";
      window.scrollTo({top:0,behavior:"smooth"});
      let toast=document.querySelector<HTMLElement>("#profile-saved-toast");
      if (!toast) { toast=document.createElement("div"); toast.id="profile-saved-toast"; toast.setAttribute("role","status"); document.body.append(toast); }
      toast.textContent=copy("Cambios guardados","Changes saved");
      toast.classList.add("visible");
      window.setTimeout(()=>toast?.classList.remove("visible"),2600);
    } catch (error) {
      if (feedback) feedback.textContent = error instanceof Error ? error.message : copy("Error al guardar.", "Save error.");
    } finally {
      button.disabled = false;
      validateSocialFields();
    }
  });

</script>
