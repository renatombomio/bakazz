---
export const prerender=false;
import Layout from "../../layouts/Layout.astro";import Navbar from "../../components/layout/Navbar.astro";import VisitorHeader from "../../components/profile/VisitorHeader";import ProfileSectionsIsland from "../../components/profile/ProfileSectionsIsland";import {createSupabaseSsrClient} from "../../lib/supabase-ssr";import {localizedPath} from "../../i18n";
const lang=Astro.locals.lang,en=lang==="en",aka=Astro.params.aka||"",supabase=createSupabaseSsrClient(Astro.request,Astro.cookies);
const {data:profile,error:profileError}=await supabase.from("profiles").select("id,name,aka,headline,bio,avatar_url,cover_url,instagram,tiktok,is_private").eq("aka",aka).maybeSingle();
if(profileError)console.error("Visitor profile:",profileError.message);if(!profile)return new Response(en?"Profile not found":"Perfil no encontrado",{status:404});
const viewer=Astro.locals.renanimeUser,isOwner=viewer?.id===profile.id,isPrivate=Boolean(profile.is_private)&&!isOwner;
const {data:statRows,error:statError}=await supabase.rpc("get_public_profile_stats",{target_user_id:profile.id});if(statError)console.error("Profile stats:",statError.message);
const aggregate=statRows?.[0]??{watched_count:0,anime_likes_count:0};
let library:any[]=[],favRows:any[]=[],charRows:any[]=[],pendingCount=0,commentsCount=0;
if(!isPrivate){const [l,f,c,p,cm]=await Promise.all([supabase.from("user_anime").select("anime_id,status,updated_at").eq("user_id",profile.id).order("updated_at",{ascending:false}),supabase.from("anime_likes").select("anime_id,created_at").eq("user_id",profile.id).order("created_at",{ascending:false}).limit(5),supabase.from("character_likes").select("character_id,created_at,characters(id,name,image_url,anime_characters(anime_id,role,sort_order))").eq("user_id",profile.id).order("created_at",{ascending:false}).limit(20),supabase.from("user_anime").select("anime_id",{count:"exact",head:true}).eq("user_id",profile.id).eq("status","pending"),supabase.from("anime_comments").select("id",{count:"exact",head:true}).eq("user_id",profile.id)]);library=l.data??[];favRows=f.data??[];charRows=c.data??[];pendingCount=p.count??0;commentsCount=cm.count??0;}
const watched=library.filter(x=>x.status==="seen"),pending=library.filter(x=>x.status==="pending"),favIds=favRows.map(x=>Number(x.anime_id)),watchIds=watched.map(x=>Number(x.anime_id)),pendingIds=pending.map(x=>Number(x.anime_id));
let viewerAnime=new Set<number>(),viewerChars=new Set<number>(),shared:any[]=[];
if(viewer&&!isOwner){const [vl,va,vc]=await Promise.all([supabase.from("user_anime").select("anime_id").eq("user_id",viewer.id).eq("status","seen"),supabase.from("anime_likes").select("anime_id").eq("user_id",viewer.id),supabase.from("character_likes").select("character_id").eq("user_id",viewer.id)]);const vSeen=new Set((vl.data??[]).map(x=>Number(x.anime_id)));viewerAnime=new Set((va.data??[]).map(x=>Number(x.anime_id)));viewerChars=new Set((vc.data??[]).map(x=>Number(x.character_id)));if(!isPrivate){const bothSeen=watchIds.filter(id=>vSeen.has(id)),bothFav=favIds.filter(id=>viewerAnime.has(id)),bothChar=charRows.filter(r=>viewerChars.has(Number(r.character_id)));const shareIds=[...new Set([...bothSeen.slice(0,3),...bothFav.slice(0,3)])];const vars:Record<string,number>={},fields=shareIds.map((id,i)=>{vars["id"+i]=id;return `m${i}:Media(id:$id${i},type:ANIME){id title{romaji english} coverImage{large}}`;}).join("\n");let media:any[]=[];if(shareIds.length){try{const r=await fetch("https://graphql.anilist.co",{method:"POST",headers:{"Content-Type":"application/json","Accept":"application/json"},body:JSON.stringify({query:`query Shared(${shareIds.map((_,i)=>"$id"+i+":Int!").join(",")}){${fields}}`,variables:vars})});const d=await r.json();media=shareIds.map((_,i)=>d.data?.["m"+i]).filter(Boolean);}catch{}}const find=(id:number)=>media.find(m=>Number(m.id)===id);if(bothSeen.length)shared.push({kind:"watched",title:en?`You have watched ${bothSeen.length} anime in common`:`Habéis visto ${bothSeen.length} animes en común`,subtitle:bothSeen.slice(0,2).map(id=>{const m=find(id);return m?(en?m.title?.english||m.title?.romaji:m.title?.romaji||m.title?.english):""}).filter(Boolean).join(" · ")+(bothSeen.length>2?(en?` and ${bothSeen.length-2} more`:` y ${bothSeen.length-2} más`):""),images:bothSeen.slice(0,3).map(id=>find(id)?.coverImage?.large).filter(Boolean)});const charImgs=bothChar.map(r=>Array.isArray(r.characters)?r.characters[0]:r.characters).map(c=>c?.image_url).filter(Boolean);const commonTotal=bothFav.length+bothChar.length;if(commonTotal)shared.push({kind:"favorites",title:en?`You share ${commonTotal} favorites`:`Coincidís en ${commonTotal} favoritos`,subtitle:bothFav.slice(0,2).map(id=>{const m=find(id);return m?(en?m.title?.english||m.title?.romaji:m.title?.romaji||m.title?.english):""}).filter(Boolean).join(" · "),images:[...bothFav.slice(0,3).map(id=>find(id)?.coverImage?.large),...charImgs].filter(Boolean).slice(0,3)});}}
const allIds=[...new Set([...favIds,...watchIds.slice(0,6),...pendingIds.slice(0,6)])],animeMap=new Map<number,any>();
if(allIds.length){const vars:Record<string,number>={},fields=allIds.map((id,i)=>{vars["id"+i]=id;return `a${i}:Media(id:$id${i},type:ANIME){id title{romaji english} coverImage{large}}`;}).join("\n");try{const r=await fetch("https://graphql.anilist.co",{method:"POST",headers:{"Content-Type":"application/json","Accept":"application/json"},body:JSON.stringify({query:`query VisitorAnime(${allIds.map((_,i)=>"$id"+i+":Int!").join(",")}){${fields}}`,variables:vars})});if(!r.ok)throw new Error("AniList unavailable");const d=await r.json();allIds.forEach((id,i)=>{if(d.data?.["a"+i])animeMap.set(id,d.data["a"+i]);});}catch(e){console.error("Visitor AniList:",e);}}
let animeTotals:Record<number,number>={};if(favIds.length){const x=await supabase.from("anime_like_totals").select("anime_id,like_count").in("anime_id",favIds.slice(0,5));animeTotals=Object.fromEntries((x.data??[]).map(r=>[Number(r.anime_id),Number(r.like_count??0)]));}
const characters=charRows.map(row=>{const c=Array.isArray(row.characters)?row.characters[0]:row.characters;if(!c?.id)return null;const rel=(c.anime_characters??[]).slice().sort((a:any,b:any)=>(a.role==="MAIN"?0:1)-(b.role==="MAIN"?0:1)||a.sort_order-b.sort_order);return{id:Number(c.id),name:c.name,image:c.image_url||"",href:rel[0]?.anime_id?localizedPath(lang,`/anime/${rel[0].anime_id}/`):localizedPath(lang,`/u/${profile.aka}/characters/`),likes:0,liked:viewerChars.has(Number(c.id))};}).filter(Boolean);
if(characters.length){const x=await supabase.from("character_like_totals").select("character_id,like_count").in("character_id",characters.slice(0,4).map(c=>c.id));const totals=Object.fromEntries((x.data??[]).map(r=>[Number(r.character_id),Number(r.like_count??0)]));characters.forEach(c=>c.likes=totals[c.id]??0);}
const favorites=favRows.slice(0,5).flatMap(row=>{const id=Number(row.anime_id),m=animeMap.get(id);return m?[{id,title:en?m.title?.english||m.title?.romaji||"Anime":m.title?.romaji||m.title?.english||"Anime",image:m.coverImage?.large||"",href:localizedPath(lang,`/anime/${id}/`),likes:animeTotals[id]??0,liked:viewerAnime.has(id)}]:[];});
const toLib=(rows:any[])=>rows.slice(0,6).flatMap(row=>{const id=Number(row.anime_id),m=animeMap.get(id);return m?[{id,title:en?m.title?.english||m.title?.romaji||"Anime":m.title?.romaji||m.title?.english||"Anime",cover:m.coverImage?.large||"",href:localizedPath(lang,`/anime/${id}/`)}]:[];});
const props={lang,owner:false,favorites,favoritesTotal:isPrivate?0:Number(aggregate.anime_likes_count??0),favoritesHref:localizedPath(lang,`/u/${profile.aka}/favorites/`),characters:characters.slice(0,4),charactersTotal:characters.length,charactersHref:localizedPath(lang,`/u/${profile.aka}/characters/`),collection:isPrivate?[]:toLib(watched),collectionTotal:isPrivate?0:watchIds.length,collectionHref:localizedPath(lang,`/u/${profile.aka}/collection/`),watchlist:isPrivate?[]:toLib(pending),watchlistTotal:isPrivate?0:pendingCount,watchlistHref:localizedPath(lang,`/u/${profile.aka}/list/`),debates:[],debatesTotal:0,debatesHref:"#",newDebateHref:"#",addFavoriteHref:localizedPath(lang,"/search/"),searchHref:localizedPath(lang,"/search/")};
const stats={watched:Number(aggregate.watched_count??0),pending:isPrivate?0:pendingCount,favorites:Number(aggregate.anime_likes_count??0),comments:isPrivate?0:commentsCount};
---
<Layout title={`@${profile.aka} — Renanime`} description={profile.headline||profile.bio||(en?"Anime fan on Renanime.":"Fan del anime en Renanime.")}><Navbar/><main class="visitor-profile-page"><article class="visitor-profile"><VisitorHeader name={profile.name||`@${profile.aka}`} handle={profile.aka} headline={profile.headline} bio={profile.bio} avatar={profile.avatar_url} banner={profile.cover_url} instagram={profile.instagram} tiktok={profile.tiktok} stats={stats} shared={viewer&&!isOwner?shared:undefined} t={{watched:en?"Watched":"Vistos",pending:en?"Pending":"Pendientes",favorites:en?"Likes":"Me gusta",comments:en?"Comments":"Comentarios"}}/><ProfileSectionsIsland client:load {...props}/></article></main></Layout>
<style>:global(html:has(.visitor-profile-page)),:global(body:has(.visitor-profile-page)){background:#000!important}.visitor-profile-page{min-height:100vh;padding:88px 0 3rem;background:#000}.visitor-profile{width:min(100%,860px);margin:0 auto;color:#f2efe9}@media(max-width:520px){.visitor-profile-page{padding-top:68px}}</style>
