---
import { localizedPath } from "../../i18n";
const lang = Astro.locals.lang;
const genres = Astro.url.searchParams.getAll("genre").map((value) => value.trim()).filter(Boolean);
const target = new URL(localizedPath(lang, "/buscar/"), Astro.url);
if (genres.length) target.searchParams.set("genre", genres.join(","));
return Astro.redirect(target.pathname + target.search, 301);
