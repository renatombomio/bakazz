---
import Container from "../ui/Container.astro";
import { localizedPath } from "../../i18n";

const year = new Date().getFullYear();
const { lang } = Astro.locals;
---

<footer class="site-footer">
  <Container class="footer-inner">
    <div class="footer-content">
      <a class="footer-wordmark" href={localizedPath(lang, "/")} aria-label="Renanime World">
        <span>Ren</span>anime World
      </a>
      <p class="footer-tagline">
        {lang === "en"
          ? "A world of stories. A community that brings them together."
          : "Un mundo de historias. Una comunidad que las une."}
      </p>
    </div>

    <div class="footer-bottom">
      <span>© {year} Renanime World.</span>
      <span>{lang === "en" ? "All rights reserved." : "Todos los derechos reservados."}</span>
    </div>
  </Container>
</footer>

<style>
  .site-footer {
    position: relative;
    overflow: hidden;
    background: #08080b;
    color: #f7f5f8;
    border-top: 1px solid rgba(255, 255, 255, .08);
  }

  .footer-inner {
    width: 100%;
    padding-block: clamp(2.5rem, 5vw, 4rem) 1.25rem;
  }

  .footer-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: .8rem;
    padding-bottom: clamp(2rem, 4vw, 3rem);
    text-align: center;
  }

  .footer-wordmark {
    color: #f7f5f8;
    font-size: clamp(1.45rem, 3vw, 2rem);
    font-weight: 850;
    letter-spacing: -.065em;
    line-height: 1;
    text-decoration: none;
  }

  .footer-wordmark span {
    color: #ec4899;
  }

  .footer-tagline {
    max-width: 32rem;
    margin: 0;
    color: #aaa5b1;
    font-size: clamp(.82rem, 1.5vw, .95rem);
    line-height: 1.6;
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: .35rem .5rem;
    padding-top: 1rem;
    border-top: 1px solid rgba(255, 255, 255, .09);
    color: #77727e;
    font-size: .68rem;
    line-height: 1.5;
    text-align: center;
  }

  @media (max-width: 480px) {
    .footer-inner {
      padding-block: 2.25rem 1rem;
    }

    .footer-content {
      padding-bottom: 1.75rem;
    }

    .footer-bottom {
      font-size: .62rem;
    }
  }
</style>
