---
import Container from "../ui/Container.astro";
import { localizedPath } from "../../i18n";

const year = new Date().getFullYear();
const { lang, basePath } = Astro.locals;
const isEnglish = lang === "en";
const isGhibli = basePath.startsWith("/ghibli");

const groups = [
  {
    title: isEnglish ? "Explore" : "Explorar",
    links: [
      { label: isEnglish ? "Search anime" : "Buscar anime", href: "/search/" },
      { label: isEnglish ? "Genres" : "Géneros", href: "/genres/" },
      { label: isEnglish ? "Ren's collection" : "Colección de Ren", href: "/ren-collection/" },
      { label: "Ghibli", href: "/ghibli/" },
    ],
  },
  {
    title: isEnglish ? "Community" : "Comunidad",
    links: [
      { label: isEnglish ? "Community home" : "Inicio de comunidad", href: "/community/" },
      { label: isEnglish ? "Debates" : "Debates", href: "/community/debates/" },
    ],
  },
  {
    title: isEnglish ? "Your space" : "Tu espacio",
    links: [
      { label: isEnglish ? "My profile" : "Mi perfil", href: "/profile/" },
      { label: isEnglish ? "My list" : "Mi lista", href: "/pending/" },
      { label: isEnglish ? "My collection" : "Mi colección", href: "/collection/" },
      { label: isEnglish ? "Favorites" : "Favoritos", href: "/favorites/" },
    ],
  },
];
---

<footer class:list={["site-footer", isGhibli && "site-footer--ghibli"]}>
  <Container class="footer-inner">
    <div class="footer-main">
      <div class="footer-brand">
        <a class="footer-wordmark" href={localizedPath(lang, "/")} aria-label="Renanime World">
          <span>Ren</span>anime World
        </a>
        <p class="footer-description">
          {isEnglish
            ? "A place to discover anime, share what you love and meet people who feel the same."
            : "Un lugar para descubrir anime, compartir lo que te gusta y conectar con quienes sienten lo mismo."}
        </p>
        <p class="footer-community-note">
          {isEnglish ? "The world of anime is better together." : "El mundo del anime se disfruta más en comunidad."}
        </p>
      </div>

      {groups.map((group) => (
        <nav class="footer-group" aria-label={group.title}>
          <h2>{group.title}</h2>
          <ul>
            {group.links.map((link) => (
              <li><a href={localizedPath(lang, link.href)}>{link.label}</a></li>
            ))}
          </ul>
        </nav>
      ))}
    </div>

    <div class="footer-bottom">
      <a class="footer-home-link" href={localizedPath(lang, "/")}>Renanime World</a>
      <span>© {year}</span>
      <span>{isEnglish ? "Made for anime fans" : "Hecho para quienes aman el anime"}</span>
    </div>
  </Container>
</footer>

<style>
  .site-footer {
    position: relative;
    background: #050506;
    color: var(--color-paper-50);
    border-top: 1px solid var(--color-border);
  }

  .site-footer--ghibli {
    background: #fff;
    color: #19362f;
    border-top-color: rgba(25, 54, 47, .12);
  }

  :global(.footer-inner) {
    width: 100%;
    padding-block: clamp(3.5rem, 7vw, 5.5rem) 1.5rem;
  }

  .footer-main {
    display: grid;
    grid-template-columns: minmax(15rem, 1.7fr) repeat(3, minmax(8rem, 1fr));
    gap: clamp(2rem, 5vw, 4.5rem);
    padding-bottom: clamp(3rem, 5vw, 4.5rem);
  }

  .footer-wordmark {
    display: inline-block;
    color: var(--color-paper-50);
    font-size: clamp(1.35rem, 2vw, 1.7rem);
    font-weight: 800;
    letter-spacing: -.055em;
    line-height: 1;
  }

  .footer-wordmark span {
    color: #ec4899;
  }

  .footer-description {
    max-width: 22rem;
    margin: 1.25rem 0 0;
    color: var(--color-muted-300);
    font-size: .95rem;
    line-height: 1.7;
  }

  .footer-community-note {
    margin: 1rem 0 0;
    color: var(--color-muted-400);
    font-size: .78rem;
    line-height: 1.5;
  }

  .footer-group h2 {
    margin: .1rem 0 1.15rem;
    color: var(--color-paper-50);
    font-size: .8rem;
    font-weight: 750;
    letter-spacing: .04em;
  }

  .footer-group ul {
    display: grid;
    gap: .8rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer-group a {
    color: var(--color-muted-400);
    font-size: .82rem;
    line-height: 1.4;
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .footer-group a:hover,
  .footer-group a:focus-visible,
  .footer-home-link:hover,
  .footer-home-link:focus-visible {
    color: #ec4899;
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: .75rem 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border);
    color: var(--color-muted-500);
    font-family: var(--font-meta);
    font-size: .58rem;
    letter-spacing: .08em;
  }

  .footer-home-link {
    color: var(--color-muted-300);
    font-weight: 700;
    text-decoration: none;
  }

  .site-footer--ghibli .footer-wordmark,
  .site-footer--ghibli .footer-group h2 {
    color: #19362f;
  }

  .site-footer--ghibli .footer-description,
  .site-footer--ghibli .footer-community-note,
  .site-footer--ghibli .footer-group a,
  .site-footer--ghibli .footer-bottom,
  .site-footer--ghibli .footer-home-link {
    color: #59756b;
  }

  .site-footer--ghibli .footer-bottom {
    border-top-color: rgba(25, 54, 47, .12);
  }

  @media (max-width: 760px) {
    :global(.footer-inner) {
      padding-block: 3.25rem 1.25rem;
    }

    .footer-main {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2.25rem 1.5rem;
      padding-bottom: 2.5rem;
    }

    .footer-brand {
      grid-column: 1 / -1;
    }

    .footer-description {
      max-width: 25rem;
    }

    .footer-bottom {
      justify-content: flex-start;
      gap: .65rem 1rem;
      font-size: .54rem;
    }
  }

  @media (max-width: 380px) {
    .footer-main {
      column-gap: 1rem;
    }
  }
</style>
