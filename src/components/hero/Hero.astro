---
import HeroCarousel, { type HeroSlide } from "./HeroCarousel";
import { heroSlides } from "../../data/hero";
import { anilistProvider } from "../../lib/api/anilist";
interface Props { kicker?:string; title?:string; copy?:string; ariaLabel?:string; videoSrc?:string; variant?:"default"|"ghibli"; }
const {kicker="Renanime's",title="Gallery.",copy="Anime a través de mis ojos.\\nEste es mi regalo para ti.",ariaLabel="Renanime's Gallery",videoSrc="/videos/hero.mp4",variant="default"}=Astro.props;
const slides:HeroSlide[]=(await Promise.all(heroSlides.map(async config=>{try{const anime=await anilistProvider.getById(config.anilistId);if(!anime)return null;return{id:config.id,title:anime.metadata.title,year:anime.metadata.year,format:anime.metadata.format,banner:anime.metadata.images.banner,cover:anime.metadata.images.cover,eyebrow:config.eyebrow,note:config.note};}catch{return null;}}))).filter((slide):slide is HeroSlide=>slide!==null);
---
<HeroCarousel client:load slides={slides} kicker={kicker} title={title} copy={copy} ariaLabel={ariaLabel} videoSrc={videoSrc} variant={variant}/>
<style>
:global(.hero){position:relative;isolation:isolate;overflow:hidden;background:var(--color-ink-950)}
:global(.hero--world){width:100%;height:clamp(440px,68svh,720px);min-height:0;max-height:760px}
:global(.hero-media){position:absolute;inset:0;z-index:-2;overflow:hidden;background:var(--color-ink-950)}
:global(.hero-video){display:block;width:100%;height:100%;object-fit:cover;object-position:center 48%}
:global(.hero--world::before){position:absolute;z-index:-1;inset:0;background:linear-gradient(90deg,rgba(5,5,8,.82) 0%,rgba(5,5,8,.48) 48%,rgba(5,5,8,.08) 100%),linear-gradient(0deg,rgba(5,5,8,.72) 0%,transparent 62%);content:"";pointer-events:none}
:global(.hero-world-inner){display:flex;align-items:flex-end;justify-content:space-between;width:min(calc(100% - (var(--gutter)*2)),var(--container-max));height:100%;margin-inline:auto;padding-block:clamp(2.5rem,6vw,5rem)}
:global(.hero-world-title){width:100%;max-width:70rem;margin:0;text-align:left}
:global(.hero-world-eyebrow){display:block;margin-bottom:.45rem;color:#fff;font-family:var(--font-meta);font-size:clamp(.7rem,1.1vw,.9rem);font-weight:700;letter-spacing:.42em;line-height:1;text-shadow:0 2px 16px rgba(0,0,0,.5)}
:global(.hero-world-title h1){display:flex;flex-wrap:nowrap;align-items:baseline;gap:.035em;margin:0;font-family:Impact,Haettenschweiler,"Arial Narrow Bold",sans-serif;font-size:clamp(4.4rem,12.5vw,11.5rem);font-stretch:condensed;font-weight:900;letter-spacing:-.055em;line-height:.78;text-transform:uppercase;white-space:nowrap;text-shadow:0 4px 28px rgba(0,0,0,.4)}
:global(.hero-wordmark-ren){color:#ec4899}:global(.hero-wordmark-anime){color:#fff}
:global(.hero-world-title .hero-copy){max-width:35rem;margin:clamp(1.2rem,2vw,1.7rem) 0 0;color:rgba(255,255,255,.9);font-size:clamp(.95rem,1.5vw,1.15rem);font-weight:500;line-height:1.45;text-align:left;text-shadow:0 2px 14px rgba(0,0,0,.55)}
:global(.hero-world-index){flex:0 0 auto;margin:0 0 .2rem 2rem;color:rgba(255,255,255,.72);font-family:var(--font-meta);font-size:.58rem;letter-spacing:.16em;text-align:right;text-shadow:0 2px 12px rgba(0,0,0,.5)}
/* Keep the Ghibli editorial variant independent. */
:global(.hero--ghibli){min-height:calc(100vh - 88px)}
:global(.hero--ghibli .hero-media){z-index:1}
:global(.hero--ghibli .hero-video){object-fit:cover}
:global(.hero--ghibli .hero-inner){position:relative;z-index:3;display:flex;width:min(calc(100% - (var(--gutter)*2)),var(--container-max));min-height:calc(100vh - 88px);margin-inline:auto;padding-block:clamp(4rem,7vw,6rem) clamp(2rem,4vw,3rem);flex-direction:column;justify-content:space-between}
:global(.hero--ghibli .hero-title){position:absolute;top:50%;left:50%;width:min(100% - 2rem,58rem);margin:0;transform:translate(-50%,-50%);text-align:center}
:global(.hero--ghibli .hero-kicker){margin:0;color:var(--color-paper-50);font-family:var(--font-body);font-size:clamp(3.25rem,6.5vw,6.25rem);font-weight:600;letter-spacing:.02em;text-shadow:0 2px 18px rgba(0,0,0,.45)}
:global(.hero--ghibli .hero-title h1){margin:.25rem 0 0;color:var(--color-paper-50);font-family:var(--font-heading);font-size:clamp(3rem,4.5vw,4.75rem);font-weight:400;letter-spacing:-.045em;line-height:.92;text-shadow:0 3px 24px rgba(0,0,0,.45)}
:global(.hero--ghibli .hero-copy){margin:2rem 0 0;color:var(--color-paper-200);font-size:var(--text-lg);line-height:1.45;text-align:center;text-shadow:0 2px 14px rgba(0,0,0,.45)}
@media(max-width:1120px){:global(.hero--ghibli),:global(.hero--ghibli .hero-inner){min-height:calc(100vh - 74px)}}
@media(max-width:720px){
:global(.hero--world){height:auto;min-height:0;aspect-ratio:16/9;max-height:none}
:global(.hero-world-inner){width:calc(100% - (var(--gutter)*2));padding-block:1.25rem}
:global(.hero-world-title h1){font-size:clamp(2.7rem,11.7vw,5rem);letter-spacing:-.06em}
:global(.hero-world-eyebrow){margin-bottom:.35rem;font-size:.56rem;letter-spacing:.34em}
:global(.hero-world-title .hero-copy){max-width:22rem;margin-top:.7rem;font-size:clamp(.68rem,2.5vw,.88rem)}
:global(.hero-world-index){display:none}
:global(.hero--ghibli){min-height:0;height:auto;overflow:visible}
:global(.hero--ghibli .hero-media){position:relative;inset:auto;width:100%;height:auto;overflow:visible}
:global(.hero--ghibli .hero-video){width:100%;height:auto;object-fit:contain;object-position:top center}
:global(.hero--ghibli .hero-inner){position:absolute;inset:0;width:100%;min-height:0;height:100%;padding:5rem var(--gutter) 2.5rem}
:global(.hero--ghibli .hero-title){top:50%;left:50%;width:calc(100% - (var(--gutter)*2))}
:global(.hero--ghibli .hero-kicker){font-size:3rem}
:global(.hero--ghibli .hero-title h1){font-size:clamp(3.5rem,15vw,4.75rem)}
:global(.hero--ghibli .hero-copy){margin-top:1.5rem;font-size:.95rem}
}
@media(max-width:380px){:global(.hero-world-title h1){font-size:10.8vw}:global(.hero-world-title .hero-copy){font-size:.64rem}}
</style>