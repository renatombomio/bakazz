---
interface Props {
  video?: { mp4: string; webm?: string } | null;
  subtitle: string;
  primary: { label: string; href: string };
  secondary?: { label: string; href: string };
}
const { video = null, subtitle, primary, secondary } = Astro.props;
---
<section class="hh" aria-label="Renanime World">
  {video && (
    <video class="hh-video" autoplay muted loop playsinline preload="metadata" aria-hidden="true">
      {video.webm && <source src={video.webm} type="video/webm" />}
      <source src={video.mp4} type="video/mp4" />
    </video>
  )}
  <div class="hh-veil" aria-hidden="true"></div>
  <div class="hh-body">
    <h1 class="hh-word" aria-label="Renanime World">
      <span class="hh-world" aria-hidden="true">WORLD</span>
      <span class="hh-name" aria-hidden="true"><b>REN</b>ANIME</span>
    </h1>
    <p class="hh-sub">{subtitle}</p>
    <div class="hh-actions">
      <a class="hh-btn" href={primary.href}>{primary.label}</a>
      {secondary && <a class="hh-btn hh-ghost" href={secondary.href}>{secondary.label}</a>}
    </div>
  </div>
</section>
<script>
  const setupHomeHero = () => {
    const hero = document.querySelector<HTMLElement>(".hh");
    const video = hero?.querySelector<HTMLVideoElement>(".hh-video");
    if (!video) return;
    const motion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const syncMotion = () => {
      if (motion.matches) {
        video.pause();
        video.removeAttribute("autoplay");
      } else {
        video.setAttribute("autoplay", "");
        void video.play().catch(() => {});
      }
    };
    syncMotion();
    motion.addEventListener("change", syncMotion);
  };
  document.addEventListener("astro:page-load", setupHomeHero);
  setupHomeHero();
</script>
<style>
  .hh {
    container-type: inline-size;
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: 760px;
    overflow: hidden;
    isolation: isolate;
    background: #09090b;
    color: #f2efe9;
  }
  .hh-video {
    position: absolute;
    z-index: -2;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  .hh-video {
    filter: saturate(.9) brightness(.58);
    transform: rotate(90deg) scale(1.9);
    transform-origin: center;
  }
  @media (max-width: 767px) {
    .hh-video { transform: rotate(90deg) scale(1.8); }
  }
  .hh-veil {
    position: absolute;
    z-index: -1;
    inset: 0;
    background: linear-gradient(to top, #09090b 0, rgba(9,9,11,.05) 62%);
    pointer-events: none;
  }
  .hh-body {
    position: relative;
    width: 100%;
    margin: 0 auto;
    padding: 0 1.4cqw 64px;
  }
  .hh-word {
    position: relative;
    display: block;
    width: 100%;
    margin: 0;
    font-family: "Anton", Impact, "Arial Narrow", sans-serif;
    font-size: calc(100cqw / 3.8);
    font-weight: 400;
    line-height: .9;
    letter-spacing: -.025em;
    text-transform: uppercase;
    white-space: nowrap;
    color: #f2efe9;
  }
  .hh-name { display: block; width: 100%; }
  .hh-name b { color: #ec4899; font-weight: 400; }
  .hh-world {
    position: absolute;
    top: -1.15em;
    right: 0;
    font-family: "Anton", Impact, "Arial Narrow", sans-serif;
    font-size: .145em;
    font-weight: 400;
    letter-spacing: .08em;
    line-height: 1;
    color: #f2efe9;
  }
  .hh-sub {
    margin: 18px 0 0;
    color: #e4e0e8;
    font-size: clamp(15px, 1.5vw, 22px);
    line-height: 1.4;
  }
  .hh-actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 20px; }
  .hh-btn {
    display: inline-flex;
    min-height: 46px;
    align-items: center;
    justify-content: center;
    padding: 13px 24px;
    border: 1px solid #ec4899;
    border-radius: 999px;
    background: #ec4899;
    color: #fff;
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
  }
  .hh-ghost { border-color: rgba(255,255,255,.35); background: transparent; color: #f2efe9; }
  .hh-btn:focus-visible { outline: 2px solid #f472b6; outline-offset: 4px; }
  @media (max-width: 767px) {
    .hh { min-height: min(760px, calc(100svh - 68px)); }
    .hh-body { padding: 0 4.1cqw 30px; }
    .hh-sub { max-width: 28ch; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hh-video { display: none; }
  }
</style>