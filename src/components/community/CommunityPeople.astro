---
interface Member { id: string; username: string; avatar?: string | null; color?: string; href: string; isOnline?: boolean }
interface Props { title: string; members: Member[]; max?: number }
const { title, members, max = 24 } = Astro.props;
const seen = new Set<string>();
const list = members.filter((member) => {
  const key = member.username.trim().toLocaleLowerCase();
  if (!key || seen.has(key)) return false;
  seen.add(key);
  return true;
}).slice(0, max);
const sizes = [76, 108, 88, 132, 80, 116, 94, 70];
const colors = ["#7c3aed", "#db2777", "#0ea5e9", "#f59e0b", "#10b981", "#ef4444"];
---
{list.length > 0 && (
  <section class="cp" aria-label={title}>
    <div class:list={["cp-track", { "cp-track--single": list.length === 1 }]} data-cp tabindex="0" role="group" aria-label={title}>
      {list.map((member, index) => {
        const name = member.username.startsWith("@") ? member.username : `@${member.username}`;
        return (
          <a class:list={["cp-item", { "cp-item--single": list.length === 1 }]} href={member.href} aria-label={name}
            style={`--w:${sizes[index % sizes.length]}px;--d:${-(index * 0.7).toFixed(1)}s;--t:${(3.6 + (index % 5) * 0.5).toFixed(1)}s`}>
            <span class="cp-av" style={member.avatar ? "" : `background:${member.color ?? colors[index % colors.length]}`}>
              {member.avatar
                ? <img src={member.avatar} alt="" width="132" height="132" loading="lazy" decoding="async" draggable="false" />
                : <b aria-hidden="true">{name.replace("@", "").charAt(0).toUpperCase()}</b>}
              <i class:list={["cp-presence", member.isOnline ? "is-online" : "is-offline"]} aria-label={member.isOnline ? "En línea" : "Desconectado"} title={member.isOnline ? "En línea" : "Desconectado"} />
            </span>
            <span class="cp-name">{name}</span>
          </a>
        );
      })}
    </div>
  </section>
)}

<style>
  .cp { min-width: 0; color: #f2efe9; padding: 8px 0 24px; }
  .cp-track { display: flex; align-items: center; height: 250px; overflow-x: auto; overflow-y: hidden;
    padding-inline: 50%; perspective: 900px; scrollbar-width: none; -webkit-overflow-scrolling: touch;
    overscroll-behavior-x: contain; scroll-behavior: auto; cursor: grab; touch-action: pan-x; }
  .cp-track::-webkit-scrollbar { display: none; }
  .cp-track--single { height: auto; min-height: 0; justify-content: flex-start; padding: 12px 16px 8px; perspective: none; overflow: visible; }
  .cp-item--single { width: 104px; margin: 0; transform: none; filter: none; }
  .cp-item--single .cp-av { width: 88px; animation: cp-float var(--t) ease-in-out var(--d) infinite alternate; }
  .cp-item--single .cp-name { position: static; display: block; margin-top: 0; transform: none; text-align: center; font-size: 12px; opacity: 1; }

  .cp-track.is-drag { cursor: grabbing; }
  .cp-track:focus-visible { outline: 2px solid #f472b6; outline-offset: -2px; }
  .cp-item { position: relative; display: flex; flex: 0 0 auto; width: 104px; flex-direction:column; align-items:center; justify-content:center; gap:10px; margin-inline: 12px; color: inherit; text-decoration: none;
    transform: translateY(var(--y, 0px)) rotateY(var(--r, 0deg)) scale(var(--s, 1)); filter: brightness(var(--o, 1));
    transform-origin: center center; will-change: transform, filter; user-select: none; -webkit-user-drag: none; }
  .cp-av { position:relative; display: block; width: 88px; flex:0 0 88px; aspect-ratio: 1; border-radius: 50%; overflow: visible;
    border: 1px solid rgba(255,255,255,.14); box-shadow: 0 14px 28px -10px rgba(0,0,0,.7);
    animation: cp-float var(--t) ease-in-out var(--d) infinite alternate; }
  .cp-av img { width: 100%; height: 100%; border-radius:50%; object-fit: cover; display: block; pointer-events: none; }
  .cp-av b { display: flex; align-items: center; justify-content: center; height: 100%; font-size: 30px; color: #fff; }
  .cp-name { position:static !important; display:block !important; max-width:110px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; font-size:13px; font-weight:650; color:#f2efe9; opacity:1 !important; visibility:visible !important; transition:none; pointer-events:none; text-align:center; }
  
  .cp-presence{position:absolute;right:-1px;bottom:-1px;z-index:2;width:16px;height:16px;border:3px solid #09090b;border-radius:50%;background:#777;box-shadow:0 2px 8px #0008}
  .cp-presence.is-online{background:#22c55e;box-shadow:0 0 0 2px #22c55e33,0 0 12px #22c55e88}
  .cp-presence.is-offline{background:#777}
  .cp-item:focus-visible { outline: 2px solid #f472b6; outline-offset: 7px; border-radius: 50%; }
  @keyframes cp-float {
    from { transform: translateY(-7px) rotate(-1.5deg); }
    to { transform: translateY(7px) rotate(1.5deg); }
  }
  @media (min-width: 768px) { .cp-track { height: 320px; } .cp-item { margin-inline: 18px; } .cp-av{width:104px;flex-basis:104px} }
  @media (prefers-reduced-motion: reduce) {
    .cp-av { animation: none; }
    .cp-item { transform: none !important; filter: none !important; }
    .cp-name { transition: none; }
  }
</style>

<script>
  type CarouselState = {
    track: HTMLElement;
    items: HTMLElement[];
    raf: number;
    resumeTimer: number;
    auto: boolean;
    visible: boolean;
    direction: 1 | -1;
    down: boolean;
    startX: number;
    startScroll: number;
    dragged: boolean;
    suppressClick: boolean;
    observer?: IntersectionObserver;
    reduce: MediaQueryList;
    onScroll: () => void;
    onPointerDown: (event: PointerEvent) => void;
    onPointerMove: (event: PointerEvent) => void;
    onPointerUp: () => void;
    onPointerCancel: () => void;
    onMouseEnter: () => void;
    onMouseLeave: () => void;
    onFocusIn: () => void;
    onFocusOut: () => void;
    onClick: (event: MouseEvent) => void;
    onKeyDown: (event: KeyboardEvent) => void;
    onMotionChange: () => void;
  };

  const states = new Map<HTMLElement, CarouselState>();

  function stop(state: CarouselState) {
    state.auto = false;
    if (state.raf) cancelAnimationFrame(state.raf);
    state.raf = 0;
  }

  function start(state: CarouselState) {
    if (state.reduce.matches || !state.visible || state.auto) return;
    state.auto = true;
    state.raf = requestAnimationFrame(() => tick(state));
  }

  function tick(state: CarouselState) {
    if (!state.auto || !state.visible) return;
    const track = state.track;
    const max = track.scrollWidth - track.clientWidth;
    if (max > 0) {
      track.scrollLeft += 0.35 * state.direction;
      if (track.scrollLeft >= max - 1) state.direction = -1;
      if (track.scrollLeft <= 1) state.direction = 1;
    }
    state.raf = requestAnimationFrame(() => tick(state));
  }

  function paint(state: CarouselState) {
    const { track, items, reduce } = state;
    const center = track.getBoundingClientRect().left + track.clientWidth / 2;
    let best: HTMLElement | null = null;
    let bestDistance = Infinity;
    const width = Math.max(track.clientWidth / 2, 1);
    for (const item of items) {
      const rect = item.getBoundingClientRect();
      const dx = rect.left + rect.width / 2 - center;
      const distance = Math.min(Math.abs(dx) / width, 1);
      const scale = reduce.matches ? 1 : 1.25 - 0.6 * distance;
      item.style.setProperty("--s", scale.toFixed(3));
      item.style.setProperty("--o", reduce.matches ? "1" : (1 - 0.45 * distance).toFixed(3));
      item.style.setProperty("--r", reduce.matches ? "0deg" : `${(-dx / Math.max(track.clientWidth, 1) * 38).toFixed(1)}deg`);
      item.style.setProperty("--y", reduce.matches ? "0px" : `${(Math.sin(items.indexOf(item) * 1.7) * 18).toFixed(1)}px`);
      const absolute = Math.abs(dx);
      if (absolute < bestDistance) { bestDistance = absolute; best = item; }
    }
    for (const item of items) item.classList.toggle("is-center", item === best);
  }

  function initialize(track: HTMLElement) {
    if (states.has(track)) return;
    const items = Array.from(track.querySelectorAll<HTMLElement>(".cp-item"));
    if (!items.length) return;
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
    const state: CarouselState = {
      track, items, raf: 0, resumeTimer: 0, auto: false, visible: true, direction: 1,
      down: false, startX: 0, startScroll: 0, dragged: false, suppressClick: false,
      reduce, onScroll: () => paint(state),
      onPointerDown: (event) => {
        stop(state);
        window.clearTimeout(state.resumeTimer);
        if (event.pointerType !== "mouse" || event.button !== 0) return;
        state.down = true;
        state.dragged = false;
        state.startX = event.clientX;
        state.startScroll = track.scrollLeft;
        track.classList.add("is-drag");
      },
      onPointerMove: (event) => {
        if (!state.down) return;
        const delta = event.clientX - state.startX;
        if (Math.abs(delta) > 4) state.dragged = true;
        if (state.dragged) track.scrollLeft = state.startScroll - delta;
      },
      onPointerUp: () => {
        if (state.down) {
          state.down = false;
          track.classList.remove("is-drag");
          if (state.dragged) {
            state.suppressClick = true;
            window.setTimeout(() => { state.suppressClick = false; }, 0);
          }
        }
        window.clearTimeout(state.resumeTimer);
        state.resumeTimer = window.setTimeout(() => start(state), 2500);
      },
      onPointerCancel: () => {
        state.down = false;
        track.classList.remove("is-drag");
        window.clearTimeout(state.resumeTimer);
        state.resumeTimer = window.setTimeout(() => start(state), 2500);
      },
      onMouseEnter: () => stop(state),
      onMouseLeave: () => { window.clearTimeout(state.resumeTimer); state.resumeTimer = window.setTimeout(() => start(state), 2500); },
      onFocusIn: () => stop(state),
      onFocusOut: () => { window.clearTimeout(state.resumeTimer); state.resumeTimer = window.setTimeout(() => start(state), 2500); },
      onClick: (event) => {
        if (state.suppressClick) { event.preventDefault(); event.stopPropagation(); }
      },
      onKeyDown: (event) => {
        if (event.key === "ArrowRight" || event.key === "ArrowLeft") {
          event.preventDefault();
          track.scrollBy({ left: (event.key === "ArrowRight" ? 1 : -1) * Math.max(120, track.clientWidth * 0.35), behavior: reduce.matches ? "auto" : "smooth" });
        } else if (event.key === "Home" || event.key === "End") {
          event.preventDefault();
          track.scrollTo({ left: event.key === "Home" ? 0 : track.scrollWidth, behavior: reduce.matches ? "auto" : "smooth" });
        }
      },
      onMotionChange: () => {
        if (reduce.matches) {
          stop(state);
          track.scrollLeft = track.scrollLeft;
        } else start(state);
        paint(state);
      },
    };
    states.set(track, state);
    track.addEventListener("scroll", state.onScroll, { passive: true });
    track.addEventListener("pointerdown", state.onPointerDown);
    window.addEventListener("pointermove", state.onPointerMove, { passive: true });
    window.addEventListener("pointerup", state.onPointerUp);
    window.addEventListener("pointercancel", state.onPointerCancel);
    track.addEventListener("mouseenter", state.onMouseEnter);
    track.addEventListener("mouseleave", state.onMouseLeave);
    track.addEventListener("focusin", state.onFocusIn);
    track.addEventListener("focusout", state.onFocusOut);
    track.addEventListener("click", state.onClick, true);
    track.addEventListener("keydown", state.onKeyDown);
    reduce.addEventListener("change", state.onMotionChange);
    if ("IntersectionObserver" in window) {
      state.observer = new IntersectionObserver(([entry]) => {
        state.visible = Boolean(entry?.isIntersecting);
        if (state.visible) start(state); else stop(state);
      }, { threshold: 0.05 });
      state.observer.observe(track);
    }
    const first = items[0];
    track.scrollLeft = first.offsetLeft - (track.clientWidth - first.offsetWidth) / 2;
    paint(state);
    start(state);
  }

  function destroyAll() {
    for (const state of states.values()) {
      stop(state);
      window.clearTimeout(state.resumeTimer);
      state.observer?.disconnect();
      state.track.removeEventListener("scroll", state.onScroll);
      state.track.removeEventListener("pointerdown", state.onPointerDown);
      window.removeEventListener("pointermove", state.onPointerMove);
      window.removeEventListener("pointerup", state.onPointerUp);
      window.removeEventListener("pointercancel", state.onPointerCancel);
      state.track.removeEventListener("mouseenter", state.onMouseEnter);
      state.track.removeEventListener("mouseleave", state.onMouseLeave);
      state.track.removeEventListener("focusin", state.onFocusIn);
      state.track.removeEventListener("focusout", state.onFocusOut);
      state.track.removeEventListener("click", state.onClick, true);
      state.track.removeEventListener("keydown", state.onKeyDown);
      state.reduce.removeEventListener("change", state.onMotionChange);
    }
    states.clear();
  }

  function initializeAll() {
    document.querySelectorAll<HTMLElement>("[data-cp]").forEach(initialize);
  }

  document.addEventListener("astro:page-load", initializeAll);
  document.addEventListener("astro:before-swap", destroyAll);
  initializeAll();
</script>
