---
import BookshelfSelection from "./BookshelfSelection";
import type { RenCollectionItem } from "../../lib/ren-collection";
import { useT, type Lang } from "../../i18n";

interface Props {
  items: RenCollectionItem[];
  lang: Lang;
}
const { items, lang } = Astro.props;
const t = useT(lang);
const recommended = items.filter((item) => item.recommended).sort((a, b) => b.popularity - a.popularity);
const watched = items.filter((item) => !item.recommended);
const featured = recommended.map((item, index) => ({
  ...item,
  featured: index % 7 === 0,
  side: Math.floor(index / 7) % 2 === 0 ? "left" : "right",
}));
const recommendedCount = recommended.length;
const totalCount = items.length;
---
<div class="ren-collection">
  <header class="collection-heading">
    <h1>{t("renCollection.title")}</h1>
    <p><strong>{totalCount}</strong> {t("renCollection.seriesWatched")} <span aria-hidden="true">·</span> <strong>{recommendedCount}</strong> {t("renCollection.recommendedCount")}</p>
  </header>

  {recommendedCount > 0 && (
    <section class="recommendations" aria-labelledby="recommendations-heading">
      <h2 id="recommendations-heading">{t("renCollection.recommended")}</h2>
      <div class="poster-wall">
        {featured.map((item, index) => (
          <a
            class:list={["poster-tile", item.featured && "poster-tile--featured", item.featured && `poster-tile--${item.side}`]}
            href={item.href}
            aria-label={item.title}
          >
            {item.cover && <img src={item.cover} alt="" width="230" height="345" loading={index < 8 ? "eager" : "lazy"} decoding="async" />}
            {item.featured && <span class="poster-title">{item.title}</span>}
          </a>
        ))}
      </div>
    </section>
  )}

  {watched.length > 0 && (
    <section class="watched" aria-labelledby="watched-heading">
      <h2 id="watched-heading">{t("renCollection.watched")}</h2>
      <BookshelfSelection items={watched} lang={lang} client:visible />
    </section>
  )}
</div>

<style>
  .ren-collection { width: 100%; container-type: inline-size; color: var(--color-paper-50); }
  .collection-heading { margin: 0 0 clamp(2.25rem, 5vw, 3.75rem); }
  .collection-heading h1 { margin: 0; color: var(--color-paper-50); font: 600 clamp(2rem, 4.2vw, 3.25rem)/1.08 var(--font-body); letter-spacing: -.045em; }
  .collection-heading p { display: flex; flex-wrap: wrap; align-items: baseline; gap: .3em; margin: .55rem 0 0; color: var(--color-muted-400); font-size: clamp(.95rem, 1.35vw, 1.1rem); }
  .collection-heading p strong { color: var(--color-paper-50); font-weight: 600; }
  .recommendations { margin: 0 0 clamp(2.5rem, 5vw, 4rem); }
  .recommendations h2, .watched h2 { margin: 0 0 1rem; color: var(--color-paper-50); font: 500 clamp(1.45rem, 2.6vw, 2rem)/1.2 var(--font-body); letter-spacing: -.025em; }
  .poster-wall { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); grid-auto-flow: dense; gap: 6px; grid-auto-rows: calc((100cqw - 30px) / 6 * 1.5); }
  .poster-tile { position: relative; display: block; min-width: 0; min-height: 0; overflow: hidden; border-radius: 6px; background: #3a3a44; }
  .poster-tile img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .poster-tile { grid-column: span 2; grid-row: span 2; }
  .poster-tile--featured { grid-column: 1 / span 4; grid-row: span 4; }
  .poster-tile--right { grid-column: 3 / span 4; }
  .poster-title { position: absolute; inset: auto 0 0; padding: 2.5rem .7rem .7rem; background: linear-gradient(180deg, transparent, rgba(0,0,0,.88)); color: #fff; font-size: clamp(.72rem, 1.4vw, 1.1rem); font-weight: 650; line-height: 1.15; }
  .watched { margin-top: clamp(2.5rem, 5vw, 4rem); }
  @media (min-width: 768px) {
    .poster-wall { grid-template-columns: repeat(12, minmax(0, 1fr)); grid-auto-rows: calc((100cqw - 66px) / 12 * 1.5); }
    .poster-tile--right { grid-column: 9 / span 4; }
  }
  @media (min-width: 1100px) {
    .poster-wall { grid-template-columns: repeat(16, minmax(0, 1fr)); grid-auto-rows: calc((100cqw - 90px) / 16 * 1.5); }
    .poster-tile--right { grid-column: 13 / span 4; }
  }
</style>
