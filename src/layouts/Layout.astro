---
interface Props {
  title?: string;
  description?: string;
}

const { lang } = Astro.locals;
const basePath = Astro.url.pathname.replace(/^\/en(?=\/|$)/, "") || "/";
const {
  title = "BAKAZZ — Anime Community",
  description = lang === "en" ? "Discover anime, share your passion and connect with the BAKAZZ anime community." : "Descubre anime, comparte tu pasión y conecta con la comunidad de BAKAZZ."
} = Astro.props;
const isAuth = basePath === "/login" || basePath === "/login/";
const isAuthenticated = Boolean(Astro.locals.bakazzUser);

import "../styles/global.css";
import "@fontsource/anton/400.css";
import { ClientRouter } from "astro:transitions";
import SoundtrackPlayer from "../components/audio/SoundtrackPlayer";
import Analytics from '@vercel/analytics/astro';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta property="og:site_name" content="BAKAZZ" />
    <meta name="theme-color" content="#09090b" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <meta name="generator" content={Astro.generator} />
    <ClientRouter />
    <title>{title}</title>
  </head>

  <body data-authenticated={isAuthenticated ? "true" : "false"}>
    <a class="skip-link" href="#main-content">{lang === "en" ? "Skip to content" : "Saltar al contenido"}</a>
    <slot />
    <Analytics />
    {!isAuth && <SoundtrackPlayer client:load transition:persist lang={lang} />}
  </body>
</html>

<style>
  .skip-link {
    position: fixed;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 999;
    padding: 0.65rem 0.8rem;
    background: var(--color-paper-50);
    color: var(--color-ink-950);
    font: var(--text-xs)/1 var(--font-mono);
    transform: translateY(-150%);
    transition: transform var(--duration-fast) var(--ease-out);
  }

  .skip-link:focus {
    transform: translateY(0);
  }
</style>

<script>
  let bakazzPresenceTimer: number | undefined;
  const sendPresenceHeartbeat = async () => {
    if (document.body.dataset.authenticated !== "true" || document.visibilityState !== "visible") return;
    try {
      const response = await fetch("/api/auth/presence", {
        method: "POST",
        credentials: "same-origin",
        headers: { "Content-Type": "application/json" },
        body: "{}",
      });
      if (response.ok) {
        const status = document.querySelector<HTMLElement>("#profile-presence");
        if (status) status.hidden = false;
      }
    } catch {
      // Presence is best-effort and must never block page rendering.
    }
  };
  const startBakazzPresence = () => {
    if (bakazzPresenceTimer) window.clearInterval(bakazzPresenceTimer);
    void sendPresenceHeartbeat();
    bakazzPresenceTimer = window.setInterval(sendPresenceHeartbeat, 45_000);
  };
  document.addEventListener("astro:page-load", startBakazzPresence);
  document.addEventListener("visibilitychange", () => {
    if (document.visibilityState === "visible") void sendPresenceHeartbeat();
  });
  startBakazzPresence();
</script>


